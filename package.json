{
  "name": "arda-docs-site",
  "version": "0.0.26",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "bun run sync && next dev",
    "build": "bun run sync && next build && node scripts/emit-catalog.mjs",
    "test": "node scripts/test-contract.mjs",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "deploy": "bun x wrangler deploy -c cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wrangler": "^4.130.0"
  }
}